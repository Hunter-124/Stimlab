 "aliasNote": "Alias targets share the heavy-atom graph exactly. The HIS tautomers (HID/HIE/HIP and the CHARMM HSD/HSE/HSP spellings) differ only in where a proton sits, and this pack has no protons, so they map onto HIS rather than duplicating its ring.",
 "linkage": {
  "protein": {
   "from": "C",
   "to": "N",
   "minAngstrom": 1.1,
   "maxAngstrom": 1.6,
   "note": "The C(i)-N(i+1) peptide bond. 1.33 A is the standard length; the window rejects the 3.8 A 'bond' that a missing loop would otherwise create."
  },
  "nucleic": {
   "from": "O3'",
   "to": "P",
   "minAngstrom": 1.3,
   "maxAngstrom": 1.9,
   "note": "The O3'(i)-P(i+1) phosphodiester bond, 1.60 A standard."
  },
  "disulfide": {
   "from": "SG",
